# Upstream Backend REST API URL
NUXT_API_BASE_URL=http://localhost:8080

# Standalone Offline Mock Mode (true = use built-in mock BFF store; false = proxy to live backend)
NUXT_MOCK_API=true

# Server BFF Encrypted Session Secret Key (Must be at least 32 characters in production)
NUXT_SESSION_PASSWORD=replace-with-a-secure-random-32-char-secret-key!

# Upstream Backend Basic Auth Credentials (Optional: only needed if backend non-bearer routes enforce basic auth)
NUXT_BACKEND_BASIC_AUTH_USERNAME=
NUXT_BACKEND_BASIC_AUTH_PASSWORD=
